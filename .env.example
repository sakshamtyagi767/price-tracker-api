# Application Settings
PROJECT_NAME="Multi-Tenant Price Tracker API"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="generate-a-secure-random-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./price_tracker.db"
# PostgreSQL production:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/price_tracker_db"

# Redis Broker (for Celery & Background Workers)
REDIS_URL="redis://localhost:6379/0"
